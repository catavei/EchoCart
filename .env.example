# Copy to .env and fill in. Never commit .env.

# --- PayPal (SANDBOX ONLY) ---
# Developer Dashboard > Apps & Credentials > Sandbox > your app.
# On the app's page, under Features > Payment capabilities, tick "Save payment methods" (Vault) and save.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The app refuses to start unless this is exactly the sandbox URL.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- LLM ---
# "anthropic" calls the Claude API; "offline" uses the built-in rule-based parser
# so the app runs without an API key (for judges / CI).
LLM_MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# A merchant's own catalogue: a Shopify-style products.json feed, as a URL or a file path.
# Leave empty to use the demo catalogue. Try: examples/linden-street-pharmacy.json
CATALOG_URL=

# The shop's name on the demo shop page (/shop/).
SHOP_NAME=

# Public URL the browser uses to reach the app (PayPal returns here after linking).
APP_BASE_URL=http://localhost:8000
