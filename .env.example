# Copy to .env and fill in. Never commit .env.

# --- PayPal (SANDBOX ONLY) ---
# Developer Dashboard > Apps & Credentials > Sandbox > your app.
# In the app's settings, tick "Accept payments" and, under Advanced options, "Vault".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The app refuses to start unless this is exactly the sandbox URL.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# PayPal REST does not support RON, so carts are priced in lei and charged in EUR
# at this fixed demo rate (EUR per 1 RON).
EUR_PER_RON=0.201

# --- LLM ---
# "anthropic" calls the Claude API; "offline" uses the built-in rule-based parser
# so the app runs without an API key (for judges / CI).
LLM_MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Public URL the browser uses to reach the app (PayPal returns here after linking).
APP_BASE_URL=http://localhost:8000
